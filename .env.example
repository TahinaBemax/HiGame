# Backend
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/higame

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Mobile Money API Keys (MVola, Orange Money, Airtel Money)
MVOLA_API_KEY=
MVOLA_API_SECRET=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Encryption Key for KYC documents
KYC_ENCRYPTION_KEY=change-me-in-production

# CORS
CORS_ORIGIN=*
